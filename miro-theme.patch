+/* =============================================================
+   Miro-style BPMN theme
+   -------------------------------------------------------------
+   Overrides bpmn-js's default black-and-white renderer with a
+   color-coded, rounded, soft-shadowed look inspired by Miro
+   boards. Targets the SVG elements bpmn-js produces — does
+   NOT touch the renderer code, so existing behavior (selection,
+   hover, snapping, autosave, etc.) is preserved.
+
+   Color palette is taken from the Atlassian Design System
+   (ADS) color tokens already used elsewhere in this app, so
+   it harmonises with the rest of the chrome.
+   ============================================================= */
+
+/* ---------- Canvas background (Miro-like soft grid) ---------- */
+.bpmn-canvas {
+  background-color: #F7F8FA !important;
+  background-image:
+    linear-gradient(rgba(9, 30, 66, 0.045) 1px, transparent 1px),
+    linear-gradient(90deg, rgba(9, 30, 66, 0.045) 1px, transparent 1px),
+    radial-gradient(circle at 50% 50%, rgba(9, 30, 66, 0.02) 0, transparent 70%) !important;
+  background-size: 24px 24px, 24px 24px, 100% 100% !important;
+}
+
+/* The viewport under the grid is usually transparent. Force it
+   to inherit the grid so the soft paper look carries through. */
+.bpmn-canvas .djs-container,
+.bpmn-canvas .djs-viewport {
+  background: transparent;
+}
+
+/* ---------- Drop shadow on shapes (not on connections / icons) ---------- */
+.djs-element.djs-shape .djs-visual {
+  filter: drop-shadow(0 2px 3px rgba(9, 30, 66, 0.14));
+  transition: filter 120ms ease;
+}
+.djs-element.djs-shape:hover .djs-visual {
+  filter: drop-shadow(0 4px 8px rgba(9, 30, 66, 0.20));
+}
+
+/* ---------- TASKS (rounded rectangles) ---------- */
+.djs-element.bpmn-element-Task .djs-visual > rect,
+.djs-element.bpmn-element-UserTask .djs-visual > rect {
+  fill: #A6CCFF !important;
+  stroke: #0747A6 !important;
+  stroke-width: 1.5px !important;
+}
+.djs-element.bpmn-element-ServiceTask .djs-visual > rect,
+.djs-element.bpmn-element-ScriptTask .djs-visual > rect {
+  fill: #E9D8FD !important;
+  stroke: #5243AA !important;
+  stroke-width: 1.5px !important;
+}
+.djs-element.bpmn-element-SendTask .djs-visual > rect,
+.djs-element.bpmn-element-ReceiveTask .djs-visual > rect {
+  fill: #ABF5D1 !important;
+  stroke: #006644 !important;
+  stroke-width: 1.5px !important;
+}
+.djs-element.bpmn-element-ManualTask .djs-visual > rect {
+  fill: #F4F5F7 !important;
+  stroke: #42526E !important;
+  stroke-width: 1.5px !important;
+}
+.djs-element.bpmn-element-BusinessRuleTask .djs-visual > rect {
+  fill: #FFBDAD !important;
+  stroke: #BF2600 !important;
+  stroke-width: 1.5px !important;
+}
+
+/* ---------- SUB-PROCESS / CALL ACTIVITY ---------- */
+.djs-element.bpmn-element-SubProcess:not(.bpmn-element-EventSubProcess) .djs-visual > rect {
+  fill: #FFFFFF !important;
+  stroke: #0747A6 !important;
+  stroke-width: 1.5px !important;
+  stroke-dasharray: 6 3 !important;
+  rx: 10 !important;
+  ry: 10 !important;
+}
+.djs-element.bpmn-element-CallActivity .djs-visual > rect {
+  fill: #FFF0B3 !important;
+  stroke: #FF8B00 !important;
+  stroke-width: 2px !important;
+  rx: 10 !important;
+  ry: 10 !important;
+}
+.djs-element.bpmn-element-EventSubProcess .djs-visual > rect {
+  fill: #FFFFFF !important;
+  stroke: #0747A6 !important;
+  stroke-width: 1.5px !important;
+  stroke-dasharray: 4 2 !important;
+  rx: 10 !important;
+  ry: 10 !important;
+}
+
+/* Ad-hoc sub-process marker (the '+' row) — keep it on theme */
+.djs-element.bpmn-element-AdHocSubProcess .djs-visual > rect {
+  fill: #FFFFFF !important;
+  stroke: #0747A6 !important;
+  stroke-width: 1.5px !important;
+}
+
+/* ---------- EVENTS (circles) ---------- */
+.djs-element.bpmn-element-StartEvent .djs-visual > circle,
+.djs-element.bpmn-element-StartEvent .djs-visual > ellipse {
+  fill: #ABF5D1 !important;
+  stroke: #006644 !important;
+  stroke-width: 2px !important;
+}
+.djs-element.bpmn-element-EndEvent .djs-visual > circle,
+.djs-element.bpmn-element-EndEvent .djs-visual > ellipse {
+  fill: #FFBDAD !important;
+  stroke: #BF2600 !important;
+  stroke-width: 2px !important;
+}
+.djs-element.bpmn-element-IntermediateThrowEvent .djs-visual > circle,
+.djs-element.bpmn-element-IntermediateThrowEvent .djs-visual > ellipse,
+.djs-element.bpmn-element-IntermediateCatchEvent .djs-visual > circle,
+.djs-element.bpmn-element-IntermediateCatchEvent .djs-visual > ellipse,
+.djs-element.bpmn-element-BoundaryEvent .djs-visual > circle,
+.djs-element.bpmn-element-BoundaryEvent .djs-visual > ellipse {
+  fill: #FFE380 !important;
+  stroke: #FF8B00 !important;
+  stroke-width: 2px !important;
+}
+
+/* ---------- GATEWAYS (diamonds) ---------- */
+.djs-element.bpmn-element-ExclusiveGateway .djs-visual > polygon,
+.djs-element.bpmn-element-ExclusiveGateway .djs-visual > path {
+  fill: #FFE380 !important;
+  stroke: #FF8B00 !important;
+  stroke-width: 1.5px !important;
+}
+.djs-element.bpmn-element-ParallelGateway .djs-visual > polygon,
+.djs-element.bpmn-element-ParallelGateway .djs-visual > path {
+  fill: #ABF5D1 !important;
+  stroke: #006644 !important;
+  stroke-width: 1.5px !important;
+}
+.djs-element.bpmn-element-InclusiveGateway .djs-visual > polygon,
+.djs-element.bpmn-element-InclusiveGateway .djs-visual > path {
+  fill: #FFE380 !important;
+  stroke: #FF8B00 !important;
+  stroke-width: 1.5px !important;
+}
+.djs-element.bpmn-element-EventBasedGateway .djs-visual > polygon,
+.djs-element.bpmn-element-EventBasedGateway .djs-visual > path {
+  fill: #E9D8FD !important;
+  stroke: #5243AA !important;
+  stroke-width: 1.5px !important;
+}
+.djs-element.bpmn-element-ComplexGateway .djs-visual > polygon,
+.djs-element.bpmn-element-ComplexGateway .djs-visual > path {
+  fill: #F4F5F7 !important;
+  stroke: #42526E !important;
+  stroke-width: 1.5px !important;
+}
+
+/* ---------- DATA OBJECTS / STORES ---------- */
+.djs-element.bpmn-element-DataObjectReference .djs-visual > path {
+  fill: #F4F5F7 !important;
+  stroke: #42526E !important;
+  stroke-width: 1.5px !important;
+}
+.djs-element.bpmn-element-DataStoreReference .djs-visual > path,
+.djs-element.bpmn-element-DataStoreReference .djs-visual > rect {
+  fill: #DEEBFF !important;
+  stroke: #0747A6 !important;
+  stroke-width: 1.5px !important;
+}
+
+/* ---------- POOLS & LANES ---------- */
+.djs-element.bpmn-element-Participant .djs-visual > rect {
+  fill: #DEEBFF !important;
+  stroke: #0747A6 !important;
+  stroke-width: 1.5px !important;
+  rx: 6 !important;
+  ry: 6 !important;
+}
+.djs-element.bpmn-element-Lane .djs-visual > rect {
+  fill: #FFFFFF !important;
+  stroke: #0747A6 !important;
+  stroke-width: 1px !important;
+}
+
+/* ---------- TEXT ANNOTATION ---------- */
+.djs-element.bpmn-element-TextAnnotation .djs-visual > path,
+.djs-element.bpmn-element-TextAnnotation .djs-visual > rect {
+  fill: #FFFFFF !important;
+  stroke: #42526E !important;
+  stroke-width: 1px !important;
+}
+
+/* ---------- GROUP ---------- */
+.djs-element.bpmn-element-Group .djs-visual > rect {
+  fill: rgba(193, 199, 208, 0.15) !important;
+  stroke: #6B778C !important;
+  stroke-width: 1.5px !important;
+  stroke-dasharray: 4 2 !important;
+  rx: 10 !important;
+  ry: 10 !important;
+}
+
+/* ---------- CONNECTIONS (flows) ---------- */
+.djs-element.bpmn-element-SequenceFlow .djs-visual path,
+.djs-element.bpmn-element-SequenceFlow .djs-visual polyline {
+  stroke: #42526E !important;
+  stroke-width: 1.6px !important;
+  stroke-linecap: round !important;
+}
+.djs-element.bpmn-element-ConditionalSequenceFlow .djs-visual path,
+.djs-element.bpmn-element-ConditionalSequenceFlow .djs-visual polyline,
+.djs-element.bpmn-element-DefaultSequenceFlow .djs-visual path,
+.djs-element.bpmn-element-DefaultSequenceFlow .djs-visual polyline {
+  stroke: #42526E !important;
+  stroke-width: 1.6px !important;
+}
+.djs-element.bpmn-element-MessageFlow .djs-visual path,
+.djs-element.bpmn-element-MessageFlow .djs-visual polyline {
+  stroke: #42526E !important;
+  stroke-width: 1.5px !important;
+  stroke-dasharray: 5 3 !important;
+}
+.djs-element.bpmn-element-Association .djs-visual path,
+.djs-element.bpmn-element-Association .djs-visual polyline,
+.djs-element.bpmn-element-DataInputAssociation .djs-visual path,
+.djs-element.bpmn-element-DataInputAssociation .djs-visual polyline,
+.djs-element.bpmn-element-DataOutputAssociation .djs-visual path,
+.djs-element.bpmn-element-DataOutputAssociation .djs-visual polyline {
+  stroke: #6B778C !important;
+  stroke-width: 1.4px !important;
+  stroke-dasharray: 3 2 !important;
+}
+
+/* Marker arrowheads — subtle but solid */
+.djs-element .djs-visual marker path,
+.djs-visual marker path {
+  fill: #42526E !important;
+  stroke: #42526E !important;
+}
+
+/* ---------- LABELS (text) ---------- */
+.djs-element .djs-label,
+.djs-element .djs-label > text,
+.djs-element .djs-labelMultiLine,
+.djs-element .djs-labelMultiLine > text,
+.djs-element .djs-labelText,
+.djs-element text {
+  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI',
+    Roboto, 'Helvetica Neue', Arial, sans-serif !important;
+  font-size: 12px !important;
+  font-weight: 500 !important;
+  fill: #172B4D !important;
+}
+.djs-element .djs-label-multi-line,
+.djs-element .djs-label-multi-line > text,
+.djs-element .djs-label-multi-line > .djs-label-text {
+  font-size: 12px !important;
+  line-height: 14px !important;
+}
+
+/* Edit-in-place label (the active text input bpmn-js shows when
+   you double-click a label) — make it readable on a colored shape */
+.djs-element .djs-label .djs-label-edit-input {
+  background: rgba(255, 255, 255, 0.92) !important;
+  border: 1px solid #0747A6 !important;
+  border-radius: 4px !important;
+  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif !important;
+  font-size: 12px !important;
+  padding: 2px 6px !important;
+  color: #172B4D !important;
+}
+
+/* ---------- ICONS inside shapes — keep them readable ---------- */
+.djs-visual .djs-icon,
+.djs-visual .bpmn-icon-task,
+.djs-visual .bpmn-icon-user,
+.djs-visual .bpmn-icon-service,
+.djs-visual .bpmn-icon-script,
+.djs-visual .bpmn-icon-send,
+.djs-visual .bpmn-icon-receive,
+.djs-visual .bpmn-icon-manual,
+.djs-visual .bpmn-icon-business-rule,
+.djs-visual .bpmn-icon-start-event,
+.djs-visual .bpmn-icon-end-event,
+.djs-visual .bpmn-icon-intermediate-event,
+.djs-visual .bpmn-icon-gateway,
+.djs-visual .bpmn-icon-data-object,
+.djs-visual .bpmn-icon-data-store,
+.djs-visual .bpmn-icon-sub-process,
+.djs-visual .bpmn-icon-call-activity {
+  fill: #172B4D !important;
+}
+
+/* ---------- SELECTION / HOVER outlines — keep visible on dark borders ---------- */
+.djs-element.selected .djs-outline,
+.djs-element.selected .djs-visual > :not(.djs-icon) {
+  stroke: #0052CC !important;
+  stroke-width: 2.5px !important;
+}
+.djs-element .djs-outline {
+  stroke: #0747A6 !important;
+  stroke-width: 1.5px !important;
+  opacity: 0.7;
+  fill: none;
+}
+
+/* ---------- CONTEXT PAD (the floating tool buttons when an element is selected) ---------- */
+.djs-context-pad .entry {
+  background: #FFFFFF !important;
+  border: 1px solid #DFE1E6 !important;
+  border-radius: 6px !important;
+  box-shadow: 0 2px 6px rgba(9, 30, 66, 0.12) !important;
+  transition: all 120ms ease;
+}
+.djs-context-pad .entry:hover {
+  background: #F4F5F7 !important;
+  border-color: #0747A6 !important;
+  box-shadow: 0 4px 10px rgba(9, 30, 66, 0.18) !important;
+}
+.djs-context-pad .entry > .djs-visual > :not(.djs-outline) {
+  fill: #42526E !important;
+  stroke: #42526E !important;
+}
+.djs-context-pad .entry:hover > .djs-visual > :not(.djs-outline) {
+  fill: #0747A6 !important;
+  stroke: #0747A6 !important;
+}
+
+/* ---------- OVERLAY / POPUP-MENU ---------- */
+.djs-popup {
+  background: #FFFFFF !important;
+  border: 1px solid #DFE1E6 !important;
+  border-radius: 8px !important;
+  box-shadow: 0 8px 24px rgba(9, 30, 66, 0.18) !important;
+  color: #172B4D !important;
+  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif !important;
+  font-size: 12px !important;
+  padding: 4px 0 !important;
+}
+.djs-popup .entry {
+  padding: 6px 12px !important;
+  border-radius: 0 !important;
+  color: #172B4D !important;
+}
+.djs-popup .entry:hover {
+  background: #F4F5F7 !important;
+}
+.djs-popup .entry.disabled {
